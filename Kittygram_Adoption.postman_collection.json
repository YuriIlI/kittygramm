{
  "info": {
    "name": "Kittygram Adoption API",
    "description": "Коллекция запросов для тестирования модуля заявок на усыновление",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Аутентификация",
      "item": [
        {
          "name": "Регистрация пользователя",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"testpass123\",\n  \"email\": \"test@example.com\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/auth/users/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["auth", "users"]
            }
          }
        },
        {
          "name": "Получение JWT токена",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"testpass123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/auth/jwt/create/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["auth", "jwt", "create"]
            }
          }
        }
      ]
    },
    {
      "name": "Коты",
      "item": [
        {
          "name": "Создание кота (требует прав администратора)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Мурзик\",\n  \"color\": \"Ginger\",\n  \"birth_year\": 2021\n}"
            },
            "url": {
              "raw": "http://localhost:8000/cats/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["cats"]
            }
          }
        }
      ]
    },
    {
      "name": "Заявки на усыновление",
      "item": [
        {
          "name": "Создание заявки",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cat\": 1,\n  \"comment\": \"Хочу забрать Мурзика домой, у меня есть опыт содержания кошек\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/applications/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["applications"]
            }
          }
        },
        {
          "name": "Список моих заявок",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{user_token}}", "type": "text" }
            ],
            "url": {
              "raw": "http://localhost:8000/applications/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["applications"]
            }
          }
        },
        {
          "name": "Детали заявки (владелец)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{user_token}}", "type": "text" }
            ],
            "url": {
              "raw": "http://localhost:8000/applications/1/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["applications", "1"]
            }
          }
        },
        {
          "name": "Список всех заявок (только для сотрудника)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}", "type": "text" }
            ],
            "url": {
              "raw": "http://localhost:8000/applications/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["applications"]
            }
          }
        },
        {
          "name": "Смена статуса заявки (только для сотрудника)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_token}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"approved\",\n  \"note\": \"Приглашаем на встречу с котом\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/applications/1/change-status/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["applications", "1", "change-status"]
            }
          }
        },
        {
          "name": "История статусов заявки",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{user_token}}", "type": "text" }
            ],
            "url": {
              "raw": "http://localhost:8000/applications/1/history/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["applications", "1", "history"]
            }
          }
        }
      ]
    },
    {
      "name": "Отрицательные кейсы",
      "item": [
        {
          "name": "Повторная заявка на того же кота",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cat\": 1,\n  \"comment\": \"Ещё раз хочу того же кота\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/applications/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["applications"]
            }
          }
        },
        {
          "name": "Короткий комментарий (менее 10 символов)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{user_token}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cat\": 2,\n  \"comment\": \"Кот\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/applications/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["applications"]
            }
          }
        },
        {
          "name": "Доступ к чужой заявке",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{other_user_token}}", "type": "text" }
            ],
            "url": {
              "raw": "http://localhost:8000/applications/1/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["applications", "1"]
            }
          }
        }
      ]
    }
  ]
}